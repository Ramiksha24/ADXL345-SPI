`timescale 1ns / 1ps
module spi_read_devid #(
    parameter CLOCK_DIV = 50  // For 100MHz clk -> 1MHz SPI (well below 5MHz max)
)(
    input wire clk,
    input wire rst_n,
    input wire start,
    output reg [7:0] devid,
    output reg done,
    output reg cs_n,
    output reg sclk,
    output reg mosi,
    input wire miso,
    output reg [7:0] shift_out,
    output reg [7:0]  shift_in
);
    localparam IDLE = 0, CS_SETUP = 1, SEND_CMD = 2, READ_DATA = 3, 
               SHIFT = 4, SAMPLE = 5, FINISH = 6, CS_HOLD = 7;
    
    reg [2:0] state;
    
    reg [3:0] bit_cnt;
    reg [7:0] clk_cnt;
    reg [1:0] byte_phase;
    reg sclk_en;
    
    // Timing parameters (in clock cycles for 100MHz clock)
    localparam DELAY_CYCLES = 20;    // 200ns @ 100MHz = 20 cycles
    localparam QUIET_CYCLES = 20;    // 200ns @ 100MHz = 20 cycles
    
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state <= IDLE;
            cs_n <= 1;
            sclk <= 1;           // CPOL=1: idle high
            mosi <= 0;
            done <= 0;
            devid <= 0;
            bit_cnt <= 0;
            clk_cnt <= 0;
            byte_phase <= 0;
            sclk_en <= 0;
            shift_out <= 0;
            shift_in <= 0;
        end else begin
            done <= 0;
            
            case (state)
                IDLE: begin
                    cs_n <= 1;
                    sclk <= 1;        // CPOL=1
                    mosi <= 0;
                    byte_phase <= 0;
                    bit_cnt <= 0;
                    clk_cnt <= 0;
                    sclk_en <= 0;
                    if (start) begin
                        cs_n <= 0;    // Assert CS
                        clk_cnt <= 0;
                        state <= CS_SETUP;
                    end
                end
                
                CS_SETUP: begin
                    // Wait tDELAY (200ns) after CS falling edge
                    if (clk_cnt < DELAY_CYCLES - 1) begin
                        clk_cnt <= clk_cnt + 1;
                    end else begin
                        clk_cnt <= 0;
                        state <= SEND_CMD;
                    end
                end
                
                SEND_CMD: begin
                    // Command byte: 0x80 (Read, MB=0, address 0x00)
                    shift_out <= 8'h80;
                    shift_in <= 0;
                    bit_cnt <= 0;
                    clk_cnt <= 0;
                    byte_phase <= 0;
                    mosi <= 1;        // MSB of 0x80 = 1
                    sclk <= 1;        // Start with SCLK high (CPOL=1)
                    state <= SHIFT;
                end
                
                READ_DATA: begin
                    // Dummy byte for reading
                    shift_out <= 8'h00;
                    shift_in <= 0;
                    bit_cnt <= 0;
                    clk_cnt <= 0;
                    byte_phase <= 1;
                    mosi <= 0;
                    sclk <= 1;
                    state <= SHIFT;
                end
                
                SHIFT: begin
                    // Generate falling edge of SCLK (data changes here in Mode 3)
                    if (clk_cnt < (CLOCK_DIV/2) - 1) begin
                        clk_cnt <= clk_cnt + 1;
                    end else begin
                        clk_cnt <= 0;
                        sclk <= 0;
                        // Update MOSI after SCLK falls (setup time for next bit)
                        if (bit_cnt < 7) begin
                            mosi <= shift_out[7 - bit_cnt - 1];
                        end
                        state <= SAMPLE;
                    end
                end
                
                SAMPLE: begin
                    // Generate rising edge of SCLK (data sampled here in Mode 3)
                    if (clk_cnt < (CLOCK_DIV/2) - 1) begin
                        clk_cnt <= clk_cnt + 1;
                    end else begin
                        clk_cnt <= 0;
                        sclk <= 1;
                        
                        // Sample MISO on rising edge
                        shift_in <= {shift_in[6:0], miso};
                        
                        if (bit_cnt == 7) begin
                            // Byte complete
                            if (byte_phase == 0) begin
                                // Command sent, now read data
                                state <= READ_DATA;
                            end else begin
                                // Data received
                                devid <= {shift_in[6:0], miso};
                                state <= CS_HOLD;
                            end
                        end else begin
                            bit_cnt <= bit_cnt + 1;
                            state <= SHIFT;
                        end
                    end
                end
                
                CS_HOLD: begin
                    // Wait tQUIET (200ns) before deasserting CS
                    sclk <= 1;  // Keep SCLK high
                    if (clk_cnt < QUIET_CYCLES - 1) begin
                        clk_cnt <= clk_cnt + 1;
                    end else begin
                        clk_cnt <= 0;
                        state <= FINISH;
                    end
                end
                
                FINISH: begin
                    done <= 1;
                    cs_n <= 1;
                    sclk <= 1;
                    state <= IDLE;
                end
                
                default: state <= IDLE;
            endcase
        end
    end
endmodule
